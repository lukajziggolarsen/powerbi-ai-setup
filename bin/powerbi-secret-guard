#!/usr/bin/env node
// Claude Code PreToolUse hook for Bash. Everything a command prints becomes
// conversation content that is sent to the model provider, so refuse commands
// that would reveal the database credentials: the profile files, the launcher
// commands that print secrets, and the environments of other processes (the
// MCP servers hold their credentials there).
//
// This catches accidental and routine reads. It is not a sandbox: a command
// that builds the path indirectly gets through, so database logins must still
// be least-privilege.

const rules = [
  [/\.config\/powerbi-ai(?![\w.-])|XDG_CONFIG_HOME\}?\/powerbi-ai(?![\w.-])/, "the credential directory ~/.config/powerbi-ai"],
  [/connections\.env(?!\.example)/, "a database profile file (connections.env)"],
  [/\bpowerbi-env\b[^|;&\n]*\s(?:get|psql-url)\b/, "powerbi-env's commands that print secrets"],
  [/\/proc\/[^\s'"]*\/environ\b/, "another process's environment (/proc/*/environ)"],
  [/(?:^|[;&|(]\s*)(?:env|printenv|export\s+-p|declare\s+-x)\s*(?:$|[;&|)])/, "a dump of the whole environment"],
];

// BSD-style `ps e`, `ps axe`, `ps eww` print each process's environment.
function psShowsEnvironment(command) {
  for (const segment of command.split(/[;&|\n]+/)) {
    const words = segment.trim().split(/\s+/);
    if (words[0] !== "ps") continue;
    if (words.slice(1).some((word) => /^[a-zA-Z]*e[a-zA-Z]*$/.test(word))) return true;
  }
  return false;
}

let input = "";
process.stdin.on("data", (chunk) => { input += chunk; });
process.stdin.on("end", () => {
  let command = "";
  try {
    const payload = JSON.parse(input);
    if (payload.tool_name !== "Bash") return;
    command = String(payload.tool_input?.command ?? "");
  } catch {
    return; // Not a hook payload; nothing to decide.
  }
  const hits = rules.filter(([pattern]) => pattern.test(command)).map(([, what]) => what);
  if (psShowsEnvironment(command)) hits.push("process environments (ps e)");
  if (!hits.length) return;
  process.stdout.write(JSON.stringify({
    hookSpecificOutput: {
      hookEventName: "PreToolUse",
      permissionDecision: "deny",
      permissionDecisionReason:
        `Blocked by powerbi-secret-guard: this command would expose ${hits.join(", ")}. ` +
        "Anything a command prints is sent to the model provider. Do not read or print " +
        "database credentials; to test a connection, run doctor.sh --live, which reports " +
        "failures without printing secrets. If the user needs the file, they can open it themselves.",
    },
  }));
});
