#!/usr/bin/env bash
set -Eeuo pipefail
set +x

profile="${1:-}"
if [[ ! "$profile" =~ ^[A-Za-z][A-Za-z0-9_]*$ ]]; then
  echo "Usage: powerbi-psql-mcp <connection-name>" >&2
  exit 2
fi

config_root="${XDG_CONFIG_HOME:-$HOME/.config}/powerbi-ai"
env_file="${POWERBI_AI_ENV_FILE:-$config_root/connections.env}"
env_reader="${POWERBI_AI_ENV_READER:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/powerbi-env}"
if [[ ! -r "$env_file" ]]; then
  echo "Missing environment file: $env_file" >&2
  exit 3
fi
if [[ ! -x "$env_reader" ]]; then
  echo "Missing environment reader: $env_reader" >&2
  exit 3
fi
if ! database_uri=$("$env_reader" psql-url "$env_file" "$profile"); then
  echo "Could not read PostgreSQL connection URL for $profile" >&2
  exit 4
fi

export DATABASE_URI="$database_uri"
version="${PSQL_MCP_VERSION:-0.3.0}"
uvx_command=$(command -v uvx || true)
if [[ -z "$uvx_command" && -x "$HOME/.local/bin/uvx" ]]; then
  uvx_command="$HOME/.local/bin/uvx"
fi
if [[ -z "$uvx_command" ]]; then
  echo "uvx is required for PostgreSQL MCP connections" >&2
  exit 5
fi
exec "$uvx_command" --from "postgres-mcp==$version" --with 'mcp[cli]<2' \
  postgres-mcp --access-mode=restricted
