#!/usr/bin/env bash
set -Eeuo pipefail
set +x

config_root="${XDG_CONFIG_HOME:-$HOME/.config}/powerbi-ai"
version_file="${POWERBI_AI_VERSIONS_FILE:-$config_root/versions.env}"
if [[ -r "$version_file" ]]; then
  # This file is installed from the trusted blueprint and contains assignments only.
  # shellcheck disable=SC1090
  source "$version_file"
fi

version="${POWERBI_MODELING_MCP_VERSION:-latest}"
package="${POWERBI_MODELING_MCP_PACKAGE:-@microsoft/powerbi-modeling-mcp@$version}"
if [[ ! "$package" =~ ^[A-Za-z0-9@._/-]+$ ]]; then
  echo "Invalid POWERBI_MODELING_MCP_PACKAGE value" >&2
  exit 2
fi

# In WSL, run the Windows package so the server can see Desktop's local
# Analysis Services process and named pipes. It also opens PBIP folders over
# \\wsl.localhost UNC paths, so one server covers both live and file workflows.
if command -v powershell.exe >/dev/null 2>&1; then
  ps_package="'${package//\'/\'\'}'"
  ps_command=$(printf '%s' \
    '$ErrorActionPreference="Stop"; Set-Location C:\; ' \
    '$npx=(Get-Command npx.cmd -ErrorAction Stop).Source; ' \
    '& $npx -y ' "$ps_package" ' --start --readwrite; exit $LASTEXITCODE')
  exec powershell.exe -NoProfile -NonInteractive -Command "$ps_command"
fi

exec npx -y "$package" --start --readwrite
