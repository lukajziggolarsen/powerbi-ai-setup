# Copy to ~/.config/powerbi-ai/connections.env and run: chmod 600 <file>
# Never commit the populated file.
#
# Naming contract:
#   PSQL_<YOUR_CONNECTION_NAME>_<FIELD>
#   MSSQL_<YOUR_CONNECTION_NAME>_<FIELD>
#
# CONNECTION_NAME is chosen by you. Use uppercase letters, numbers, and
# underscores, beginning with a letter. Repeat a complete block for every
# database. The installer discovers all blocks automatically.

# PostgreSQL connection named SALES
PSQL_SALES_URL='postgresql://read_only_user:replace-me@postgres-host:5432/sales_database?options=-csearch_path%3Dreporting&sslmode=require'

# A second PostgreSQL connection named ARCHIVE
PSQL_ARCHIVE_URL='postgresql://read_only_user:replace-me@archive-postgres-host:5432/archive_database?options=-csearch_path%3Dpublic'

# SQL Server connection named ERP
MSSQL_ERP_HOST='sqlserver-host'
MSSQL_ERP_PORT='1433'
MSSQL_ERP_DATABASE='erp_database'
MSSQL_ERP_SCHEMA='dbo'
MSSQL_ERP_USER='read_only_user'
MSSQL_ERP_PASSWORD='replace-me'
MSSQL_ERP_ENCRYPT='true'

# A second SQL Server connection named LEGACY
MSSQL_LEGACY_HOST='legacy-sqlserver-host'
MSSQL_LEGACY_PORT='1433'
MSSQL_LEGACY_DATABASE='legacy_database'
MSSQL_LEGACY_SCHEMA='reporting'
MSSQL_LEGACY_USER='read_only_user'
MSSQL_LEGACY_PASSWORD='replace-me'
MSSQL_LEGACY_ENCRYPT='true'

# Optional per-connection MCP display-name overrides:
# PSQL_SALES_MCP_NAME=warehouse-postgres
# MSSQL_ERP_MCP_NAME=operations-sqlserver
