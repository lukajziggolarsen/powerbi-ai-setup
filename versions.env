# Everything not maintained in this repository follows its upstream latest
# release: every setup.sh run installs it, and the MCP launchers re-resolve
# "latest" on each start. Replace "latest" with an exact version only for a
# temporary compatibility pin. Agent CLIs and the Microsoft plugin always track
# latest; only the local powerbi-engineering plugin is versioned here in git.
POWERBI_REPORT_AUTHORING_CLI_VERSION=latest
POWERBI_DESKTOP_BRIDGE_CLI_VERSION=latest
POWERBI_MODELING_MCP_VERSION=latest
PSQL_MCP_VERSION=latest
# Interpreter for postgres-mcp (uv downloads it when the distro lacks it). Its
# pglast dependency has no wheels past 3.13, so do not follow the distro Python.
PSQL_MCP_PYTHON=3.12
TOOLBOX_MCP_VERSION=latest
UV_VERSION=latest
# Node.js is installed only when no Node.js 22+ is on PATH; "lts" resolves
# to the newest LTS release on nodejs.org at setup time.
NODE_VERSION=lts

# The local powerbi-engineering plugin is versioned by
# plugins/powerbi-engineering/.claude-plugin/plugin.json, not here.
