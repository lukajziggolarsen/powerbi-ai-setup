# Upstream packages follow their registries' latest release by default.
# Replace "latest" with an exact version only for a temporary compatibility pin.
POWERBI_REPORT_AUTHORING_CLI_VERSION=latest
POWERBI_DESKTOP_BRIDGE_CLI_VERSION=latest
POWERBI_MODELING_MCP_VERSION=latest
PSQL_MCP_VERSION=latest
TOOLBOX_MCP_VERSION=latest
UV_VERSION=latest

# Personal/local plugins are deliberately versioned here and are never
# automatically upgraded from an online source.
POWERBI_ENGINEERING_PLUGIN_VERSION=0.4.1
